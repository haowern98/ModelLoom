{
  "name": "@modelloom/desktop",
  "productName": "ModelLoom",
  "version": "0.1.0",
  "description": "ModelLoom desktop foundation and Models demo",
  "private": true,
  "main": ".vite/build/index.cjs",
  "author": "ModelLoom",
  "scripts": {
    "start": "electron-forge start",
    "dev:web": "vite --config vite.renderer.config.ts --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build --config vite.renderer.config.ts",
    "build:demo": "vite build --config vite.renderer.config.ts --mode demo",
    "package": "electron-forge package",
    "package:demo": "node scripts/package-demo.mjs",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project browser",
    "test:desktop": "playwright test --project desktop"
  },
  "dependencies": {
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.7.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "44.5.1",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vitest": "5.0.3"
  }
}
